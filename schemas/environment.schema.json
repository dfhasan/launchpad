{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dfhasan/launchpad/schemas/environment.schema.json",
  "title": "Launchpad environment",
  "description": "One file in /environments = one running environment. Everything except name/app/team/owner/image_tag has a golden-path default.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "app",
    "team",
    "owner",
    "image_tag"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,24}$",
      "description": "Must match the file name"
    },
    "app": {
      "type": "string",
      "description": "An app registered in live/platform (var.apps)"
    },
    "team": {
      "type": "string",
      "minLength": 2
    },
    "owner": {
      "type": "string",
      "description": "GitHub handle of the person responsible"
    },
    "image_tag": {
      "type": "string",
      "minLength": 1,
      "description": "Updated automatically by CI on every build"
    },
    "size": {
      "enum": [
        "small",
        "medium",
        "large"
      ],
      "default": "small"
    },
    "replicas": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6,
      "default": 1
    },
    "database": {
      "enum": [
        "sqlite",
        "mysql"
      ],
      "default": "sqlite",
      "description": "sqlite = ephemeral (previews); mysql = RDS"
    },
    "worker": {
      "type": "boolean",
      "default": false,
      "description": "Run a queue:work service (requires mysql)"
    },
    "spot": {
      "type": "boolean",
      "default": true,
      "description": "Fargate Spot (~70% cheaper, can be interrupted)"
    },
    "primary": {
      "type": "boolean",
      "default": false,
      "description": "Catch-all route on the ALB"
    },
    "expires": {
      "type": "string",
      "format": "date",
      "description": "YYYY-MM-DD. The reaper workflow removes the environment after this date."
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$",
        "not": {
          "enum": [
            "APP_KEY",
            "DB_PASSWORD",
            "DB_HOST"
          ]
        }
      },
      "description": "Plain (non-secret) environment variables for the app"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "database"
        ],
        "properties": {
          "database": {
            "const": "mysql"
          }
        }
      },
      "else": {
        "properties": {
          "worker": {
            "const": false,
            "description": "sqlite cannot be shared with a worker"
          },
          "replicas": {
            "maximum": 1
          }
        }
      }
    }
  ]
}
